{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbimagent.local/schemas/blender_execution_plan.schema.json",
  "title": "BlenderExecutionPlanV1",
  "type": "object",
  "required": [
    "plan_version", "protocol_version", "host_api_version", "plan_id", "ir_id",
    "source_ir_sha256", "compiled_ir_sha256", "units", "collection_name", "operations", "canonical_sha256",
    "idempotency_key"
  ],
  "additionalProperties": false,
  "properties": {
    "plan_version": {"type": "string", "pattern": "^1(?:\\.\\d+)?$"},
    "protocol_version": {"type": "string", "pattern": "^1(?:\\.\\d+)?$"},
    "host_api_version": {"const": "5.2"},
    "plan_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "ir_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "source_ir_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "compiled_ir_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "units": {"const": "m"},
    "collection_name": {"type": "string", "minLength": 1, "maxLength": 256},
    "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operation"}},
    "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "idempotency_key": {"type": "string", "pattern": "^blender-plan:[0-9a-f]{64}$"}
  },
  "$defs": {
    "coordinate": {
      "type": "object",
      "required": ["x_m", "y_m", "z_m"],
      "additionalProperties": false,
      "properties": {
        "x_m": {"type": "number"},
        "y_m": {"type": "number"},
        "z_m": {"type": "number"}
      }
    },
    "customProperty": {
      "type": "object",
      "required": ["property_name", "value"],
      "additionalProperties": false,
      "properties": {
        "property_name": {
          "type": "string",
          "pattern": "^openbim_[a-z][a-z0-9_]*$",
          "maxLength": 128
        },
        "value": {"type": ["string", "number", "integer", "boolean"]}
      }
    },
    "operation": {
      "type": "object",
      "required": [
        "operation", "operation_id", "object_id", "object_type", "object_name",
        "collection_name", "primitive", "units", "position", "centerline", "diameter_mm",
        "material", "properties", "references"
      ],
      "additionalProperties": false,
      "properties": {
        "operation": {"enum": ["create_object", "set_properties", "connect_topology"]},
        "operation_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "object_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "object_type": {
          "enum": [
            "utility_system", "manhole", "inlet", "outlet", "junction", "valve",
            "equipment", "terminal", "distribution_port", "pipe_segment"
          ]
        },
        "object_name": {"type": ["string", "null"], "maxLength": 256},
        "collection_name": {"type": ["string", "null"], "maxLength": 256},
        "primitive": {"enum": ["empty", "cylinder", "uv_sphere", "polyline_curve", null]},
        "units": {"const": "m"},
        "position": {"oneOf": [{"$ref": "#/$defs/coordinate"}, {"type": "null"}]},
        "centerline": {"type": "array", "items": {"$ref": "#/$defs/coordinate"}},
        "diameter_mm": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "material": {"type": ["string", "null"], "maxLength": 256},
        "properties": {"type": "array", "items": {"$ref": "#/$defs/customProperty"}},
        "references": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
