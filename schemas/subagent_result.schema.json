{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbimagent.local/schemas/subagent_result.schema.json",
  "title": "SubagentResultEnvelopeV1",
  "type": "object",
  "required": ["protocol_version", "request_id", "agent_id", "parent_session_id", "child_session_id", "child_session_path", "status", "summary", "hint", "artifacts", "manifest_path", "started_at", "ended_at", "usage", "error", "receipt_id", "lineage_id", "attempt_number", "resumed_from_request_id"],
  "additionalProperties": false,
  "properties": {
    "protocol_version": { "type": "string", "pattern": "^1(\\.\\d+)?$" },
    "request_id": { "type": "string", "minLength": 1 },
    "agent_id": { "type": "string", "minLength": 1 },
    "parent_session_id": { "type": "string", "minLength": 1 },
    "child_session_id": { "type": "string", "minLength": 1 },
    "child_session_path": { "type": "string", "minLength": 1 },
    "status": { "enum": ["completed", "failed", "cancelled"] },
    "summary": { "type": "string", "maxLength": 100000 },
    "hint": { "type": "string", "maxLength": 200 },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "kind", "path", "sha256", "size_bytes", "immutable"],
        "additionalProperties": false,
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1, "maxLength": 128 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "immutable": { "const": true }
        }
      }
    },
    "manifest_path": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": "string", "format": "date-time" },
    "usage": { "type": "object", "additionalProperties": { "type": ["integer", "number"] } },
    "error": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["code", "message", "retryable"],
          "additionalProperties": false,
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 },
            "retryable": { "type": "boolean" }
          }
        }
      ]
    },
    "receipt_id": { "type": "string", "minLength": 1 },
    "lineage_id": { "type": "string", "minLength": 1 },
    "attempt_number": { "type": "integer", "minimum": 1 },
    "resumed_from_request_id": { "type": ["string", "null"], "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "completed" } } },
      "then": { "properties": { "error": { "type": "null" } } }
    },
    {
      "if": { "properties": { "status": { "enum": ["failed", "cancelled"] } } },
      "then": { "properties": { "error": { "type": "object" } } }
    },
    {
      "if": { "properties": { "attempt_number": { "const": 1 } }, "required": ["attempt_number"] },
      "then": { "properties": { "resumed_from_request_id": { "type": "null" } } },
      "else": { "properties": { "resumed_from_request_id": { "type": "string", "minLength": 1 } } }
    }
  ]
}
