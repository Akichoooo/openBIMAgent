{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbimagent.local/schemas/ipc_request.schema.json",
  "title": "RuntimeIpcRequestV1",
  "type": "object",
  "required": ["protocol_version", "message_id", "operation", "actor", "idempotency_key", "payload", "bearer_token"],
  "additionalProperties": false,
  "properties": {
    "protocol_version": {"type": "string", "pattern": "^1(?:\\.\\d+)?$"},
    "message_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "operation": {"enum": ["ping", "approval.decide", "attempt.resume", "attempt.steer", "attempt.cancel"]},
    "actor": {
      "type": "object",
      "required": ["protocol_version", "actor_id", "actor_type", "display_name"],
      "additionalProperties": false,
      "properties": {
        "protocol_version": {"type": "string", "pattern": "^1(?:\\.\\d+)?$"},
        "actor_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.:@/-]+$"},
        "actor_type": {"enum": ["human", "agent", "service"]},
        "display_name": {"type": ["string", "null"], "minLength": 1, "maxLength": 128}
      }
    },
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9_.:@/-]+$"},
    "payload": {"type": "object"},
    "bearer_token": {"type": "string", "minLength": 32, "maxLength": 256}
  }
}
