{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbimagent.local/schemas/semantic_snapshot.schema.json",
  "title": "SemanticSnapshotV1",
  "type": "object",
  "required": ["snapshot_version", "host", "host_adapter", "source_ir_id", "source_ir_sha256", "units", "objects", "allowed_host_differences", "canonical_sha256"],
  "additionalProperties": false,
  "properties": {
    "snapshot_version": {"type": "string", "pattern": "^1(\\.\\d+)?$"},
    "host": {"enum": ["blender", "vectorworks"]},
    "host_adapter": {"type": "string", "minLength": 1, "maxLength": 128},
    "source_ir_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "source_ir_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "units": {"const": "m"},
    "objects": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/semanticObject"}},
    "allowed_host_differences": {"const": ["host_handle", "presentation_material"]},
    "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "coordinate": {
      "type": "object",
      "required": ["x_m", "y_m", "z_m"],
      "additionalProperties": false,
      "properties": {
        "x_m": {"type": "number"},
        "y_m": {"type": "number"},
        "z_m": {"type": "number"}
      }
    },
    "semanticObject": {
      "type": "object",
      "required": ["stable_id", "object_kind", "system_id", "position", "centerline", "topology", "diameter_mm", "horizontal_length_m", "start_invert_m", "end_invert_m", "slope", "material", "ifc_class", "ifc_predefined_type", "domain_properties", "source_ir_path", "host_handle", "presentation_material"],
      "additionalProperties": false,
      "properties": {
        "stable_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "object_kind": {"enum": ["system", "node", "port", "segment"]},
        "system_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "position": {"oneOf": [{"$ref": "#/$defs/coordinate"}, {"type": "null"}]},
        "centerline": {"type": "array", "items": {"$ref": "#/$defs/coordinate"}},
        "topology": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "diameter_mm": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "horizontal_length_m": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "start_invert_m": {"type": ["number", "null"]},
        "end_invert_m": {"type": ["number", "null"]},
        "slope": {"type": ["number", "null"]},
        "material": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "ifc_class": {"type": "string", "pattern": "^Ifc[A-Za-z0-9]+$"},
        "ifc_predefined_type": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
        "domain_properties": {"type": "object", "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null"]}},
        "source_ir_path": {"type": "string", "pattern": "^/(systems|nodes|segments)/[0-9]+(?:/ports/[0-9]+)?$"},
        "host_handle": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "presentation_material": {"type": ["string", "null"], "minLength": 1, "maxLength": 256}
      }
    }
  }
}
