{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbimagent.local/schemas/clearance_exception_approval.schema.json",
  "title": "ClearanceExceptionApproval",
  "description": "T6 减距例外审批协议；必须绑定规则集与规则摘要、审批权限、作用域、有效期和审计引用。",
  "type": "object",
  "required": ["protocol_version", "exception_id", "rule_set_sha256", "rule_sha256", "original_rule_id", "original_clearance_m", "approved_clearance_m", "safety_measures", "rationale", "risks", "approver_id", "approver_role", "approver_authorities", "valid_scope", "approved_at", "expires_at", "approval_status", "audit_references", "canonical_sha256"],
  "additionalProperties": false,
  "properties": {
    "protocol_version": {"const": "1.0"},
    "exception_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "rule_set_sha256": {"$ref": "#/$defs/hash"},
    "rule_sha256": {"$ref": "#/$defs/hash"},
    "original_rule_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "original_clearance_m": {"type": "number", "exclusiveMinimum": 0},
    "approved_clearance_m": {"type": "number", "exclusiveMinimum": 0},
    "safety_measures": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 4096},
    "risks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "approver_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "approver_role": {"type": "string", "minLength": 1, "maxLength": 256},
    "approver_authorities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "valid_scope": {
      "type": "object",
      "required": ["project_id", "subject_ids", "rule_ids"],
      "additionalProperties": false,
      "properties": {
        "project_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "subject_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "rule_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
      }
    },
    "approved_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "approval_status": {"enum": ["draft", "approved", "rejected", "revoked"]},
    "audit_references": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "canonical_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
