{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbimagent.local/schemas/m2_authenticated_principal.schema.json",
  "title": "M2AuthenticatedPrincipalV0_1",
  "type": "object",
  "required": [
    "protocol_version",
    "actor",
    "roles",
    "authentication_context_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "protocol_version": {"const": "0.1"},
    "actor": {
      "type": "object",
      "required": ["protocol_version", "actor_id", "actor_type", "display_name"],
      "additionalProperties": false,
      "properties": {
        "protocol_version": {"type": "string", "pattern": "^1(?:\\.\\d+)?$"},
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:@/-]+$"
        },
        "actor_type": {"enum": ["human", "service"]},
        "display_name": {"type": ["string", "null"], "minLength": 1, "maxLength": 128}
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["viewer", "operator", "admin"]}
    },
    "authentication_context_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "x-openbimagent-provider-neutral": true,
  "x-openbimagent-remote-payload-policy-version": "0.1",
  "x-openbimagent-secret-fields-allowed": false,
  "x-openbimagent-authentication-mechanism-selected": false
}
