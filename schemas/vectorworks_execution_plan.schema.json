{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbimagent.local/schemas/vectorworks_execution_plan.schema.json",
  "title": "VectorworksExecutionPlanV1",
  "type": "object",
  "required": [
    "plan_version", "protocol_version", "host_api_version", "plan_id", "ir_id",
    "source_ir_sha256", "compiled_ir_sha256", "units", "operations", "canonical_sha256", "idempotency_key"
  ],
  "additionalProperties": false,
  "properties": {
    "plan_version": {"type": "string", "pattern": "^1(?:\\.\\d+)?$"},
    "protocol_version": {"type": "string", "pattern": "^1(?:\\.\\d+)?$"},
    "host_api_version": {"const": "2024"},
    "plan_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "ir_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "source_ir_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "compiled_ir_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "units": {"const": "m"},
    "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operation"}},
    "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "idempotency_key": {"type": "string", "pattern": "^vw-plan:[0-9a-f]{64}$"}
  },
  "$defs": {
    "coordinate": {
      "type": "object",
      "required": ["x_m", "y_m", "z_m"],
      "additionalProperties": false,
      "properties": {"x_m": {"type": "number"}, "y_m": {"type": "number"}, "z_m": {"type": "number"}}
    },
    "recordField": {
      "type": "object",
      "required": ["field_name", "value", "unit"],
      "additionalProperties": false,
      "properties": {
        "field_name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$", "maxLength": 128},
        "value": {"type": ["string", "number", "integer", "boolean"]},
        "unit": {"type": ["string", "null"], "maxLength": 32}
      }
    },
    "operation": {
      "type": "object",
      "required": [
        "operation", "operation_id", "object_id", "object_type", "name", "layer_name",
        "class_name", "units", "position", "centerline", "diameter_mm", "material", "slope",
        "ifc_class", "ifc_predefined_type", "record_name", "record_fields", "references"
      ],
      "additionalProperties": false,
      "properties": {
        "operation": {"enum": ["create_object", "set_record", "connect_topology"]},
        "operation_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "object_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "object_type": {"enum": ["utility_system", "manhole", "inlet", "outlet", "junction", "valve", "equipment", "terminal", "distribution_port", "pipe_segment"]},
        "name": {"type": ["string", "null"], "maxLength": 256},
        "layer_name": {"type": ["string", "null"], "maxLength": 256},
        "class_name": {"type": ["string", "null"], "maxLength": 256},
        "units": {"const": "m"},
        "position": {"oneOf": [{"$ref": "#/$defs/coordinate"}, {"type": "null"}]},
        "centerline": {"type": "array", "items": {"$ref": "#/$defs/coordinate"}},
        "diameter_mm": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "material": {"type": ["string", "null"], "maxLength": 256},
        "slope": {"type": ["number", "null"]},
        "ifc_class": {"type": ["string", "null"], "pattern": "^Ifc[A-Za-z0-9]+$"},
        "ifc_predefined_type": {"type": ["string", "null"], "maxLength": 128},
        "record_name": {"type": ["string", "null"], "maxLength": 128},
        "record_fields": {"type": "array", "items": {"$ref": "#/$defs/recordField"}},
        "references": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
