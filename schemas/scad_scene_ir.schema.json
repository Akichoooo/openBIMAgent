{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbimagent.local/schemas/scad_scene_ir.schema.json",
  "title": "ScadSceneIR",
  "description": "SCAD 环消费的「编译 IR」(DECISIONS_DRAFT 附录 B 第 8 条):solver 出坐标后 assets 带 primitive/size/position,与 planner 产出的「语义 IR」(scene_graph_ir,C2 禁坐标)严格区分。消费方 = vision.scad_loop.ir_to_scad(确定性,无 LLM);asset id 非空在此强约束,id 唯一性由 ir_to_scad 运行时把关(JSON Schema 不表达)。",
  "type": "object",
  "required": ["assets"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "description": "IR 格式版本,如 \"0.1\"。" },
    "assets": {
      "type": "array",
      "minItems": 1,
      "description": "编译后资产清单(带图元/尺寸/坐标;ir_to_scad 要求非空)。",
      "items": { "$ref": "#/$defs/asset" }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "required": ["id", "primitive", "size", "position"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "description": "资产 id(非空;唯一性由 ir_to_scad 运行时把关)。" },
        "primitive": {
          "enum": ["cube", "cylinder", "sphere", "cone"],
          "description": "图元(scad_loop.PRIMITIVES);size 形态随图元,见 allOf 分派。"
        },
        "size": {
          "type": ["number", "array"],
          "description": "尺寸,形态随 primitive:cube=[x,y,z],cylinder=[r,h],sphere=r 或 [r],cone=[r1,r2,h]。"
        },
        "position": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3,
          "description": "图元中心坐标 [x,y,z](ir_to_scad 以 center=true 输出)。"
        },
        "color": { "type": "string", "minLength": 1, "description": "OpenSCAD color() 颜色名,可选。" }
      },
      "allOf": [
        {
          "if": { "properties": { "primitive": { "const": "cube" } }, "required": ["primitive"] },
          "then": {
            "properties": {
              "size": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 3,
                "maxItems": 3,
                "description": "cube: [x,y,z] 三边长。"
              }
            }
          }
        },
        {
          "if": { "properties": { "primitive": { "const": "cylinder" } }, "required": ["primitive"] },
          "then": {
            "properties": {
              "size": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 2,
                "maxItems": 2,
                "description": "cylinder: [r,h] 半径与高。"
              }
            }
          }
        },
        {
          "if": { "properties": { "primitive": { "const": "sphere" } }, "required": ["primitive"] },
          "then": {
            "properties": {
              "size": {
                "anyOf": [
                  { "type": "number" },
                  {
                    "type": "array",
                    "items": { "type": "number" },
                    "minItems": 1,
                    "maxItems": 1
                  }
                ],
                "description": "sphere: r 标量或 [r] 单元素数组。"
              }
            }
          }
        },
        {
          "if": { "properties": { "primitive": { "const": "cone" } }, "required": ["primitive"] },
          "then": {
            "properties": {
              "size": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 3,
                "maxItems": 3,
                "description": "cone: [r1,r2,h] 上下半径与高(r2=0 为尖锥)。"
              }
            }
          }
        }
      ]
    }
  }
}
